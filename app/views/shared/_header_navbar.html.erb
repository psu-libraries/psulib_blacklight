<header>
  <nav class="navbar navbar-expand-md navbar-dark" role="navigation">
    <div class="<%= container_classes %>">
      <div class="navbar-brand header-mark">
      <%= link_to image_tag(Shakapacker.manifest.lookup!('static/psulib_blacklight/images/logo.png'), alt: 'Penn State University Libraries logo', class: 'img-fluid'), 'https://libraries.psu.edu', title: t('blacklight.organization_name').html_safe %>
        <div class="divider divider--orientation-vertical-md divider--width-xl divider--color-pugh divider--thickness-sm"></div>
        <%= link_to t('blacklight.application_short_name'), root_path, class: 'site-title' %>
      </div>
    </div>
  </nav>
</header>
<% unless params['action'] == 'advanced_search' %>
<div class="navbar-search navbar navbar-expand-md navbar-light bg-light" role="navigation">
  <div class="<%= container_classes %>">
    <%= render PsulSearchBarComponent.new(
          url: search_action_url,
          params: search_state.params_for_search.except(:qt)
        ) %>
        <div class="col-md d-none d-md-block">
    <ul class="list-inline mt-1 mb-0">
      <li class="list-inline-item"><%= link_to 'Advanced search', blacklight_advanced_search_engine.advanced_search_path %></li>
      <li class="list-inline-item"><%= link_to t('blacklight.search.start_over'), root_path %></li>
    </ul>
  </div>
  </div>
</div>
<% end %>
