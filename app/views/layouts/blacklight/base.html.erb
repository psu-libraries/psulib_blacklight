<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <!-- Internet Explorer use the highest version available -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="namespace" content="<%= PsulibBlacklight::SolrRequestConfig.new(request).selected_namespace %>">

  <title><%= render_page_title %></title>
  <%= opensearch_description_tag application_name, opensearch_catalog_url(format: 'xml') %>
  <%= favicon_pack_tag 'static/psulib_blacklight/images/icons/favicon.ico', rel: 'favicon-icon', type: 'image/ico' %>

  <%= stylesheet_pack_tag 'application' %>
  <link rel="stylesheet" href="https://assets.libraries.psu.edu/psulib_base/dist/peripheral/peripheral.min.css">
  <%= stylesheet_pack_tag 'overrides' %>
  <%= javascript_pack_tag 'application', 'data-turbo-track': 'reload', defer: true %>
  <%= csrf_meta_tags %>
  <%= content_for(:head) %>

  # <!-- Google Tag Manager -->
  # <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  # new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  # j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  # 'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  # })(window,document,'script','dataLayer','GTM-KCXL2VQQ');</script>
  # <!-- End Google Tag Manager -->
  <script src="https://psu.libanswers.com/load_chat.php?hash=d51e38627705fc23934afaba4f563cc8"></script>
</head>

<body class="<%= render_body_class %>">
# <!-- Google Tag Manager (noscript) -->
# <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KCXL2VQQ"
# height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
# <!-- End Google Tag Manager (noscript) -->

<%= render partial: 'shared/announcement' unless Settings.hide_announcement %>
<%= render partial: 'shared/header_navbar' %>

<main id="main-container" class="main-blacklight-container <%= container_classes %>">
  <%= content_for(:container_header) %>

  <%= render partial: 'shared/flash_msg', layout: 'shared/flash_messages' %>

  <% if @document || @search_context %>
    <div class="seconday-actions d-flex justify-content-start border-bottom pb-2 mb-2">
      <% if @search_context %>
        <% if current_search_session && current_search_session['document_id'] == @document.id %>
          <div id="appliedParams" class="col-auto">
            <%= link_back_to_catalog label: t('blacklight.back_to_search.html'), class: 'btn btn-outline-secondary btn-sm' %>
          </div>
        <% end %>
        <%= render(Blacklight::SearchContext::ServerItemPaginationComponent.new(search_context: @search_context, search_session: search_session, current_document: @document)) if search_session['document_id'] == @document.id %>

      <% end %>
      <% if @document %>
        <%= render 'record_toolbar' %>
      <% end %>
    </div>
  <% end %>

  <div class="row">
    <%= content_for?(:content) ? yield(:content) : yield %>
  </div>
  <div class="ask" id="libchat_d51e38627705fc23934afaba4f563cc8"></div>
</main>

<%= render partial: 'shared/footer' %>
<%= render partial: 'shared/modal' %>
</body>
</html>
